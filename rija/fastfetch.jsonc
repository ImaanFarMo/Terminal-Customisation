{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/Users/imaanjaffer/Downloads/rija10.png",
    "height": 15,
    "width": 33,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "    ",
    "color": "yellow",
    "key": {
      "width": 16
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": " "
      },
      "width": 36
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": "{#33;1} Rija virani {#}",
      "outputColor": "yellow"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "key": "User",
      "keyColor": "yellow;1",
      "format": "{#33;1}rijavirani@rija.icloud.com{#}"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "yellow;1"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "yellow;1"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "yellow;1"
    },
    {
      "type": "host",
      "key": "Device",
      "keyColor": "yellow;1"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "yellow;1"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "yellow;1"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "yellow;1",
      "percent": {
        "type": 0
      }
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "yellow;1",
      "percent": {
        "type": 0
      }
    },
    {
      "type": "colors",
      "paddingLeft": 5,
      "symbol": "square"
    },
    {
      "type": "custom",
      "format": ""
    }
  ]
}
