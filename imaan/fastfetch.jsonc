{
  "$schema": "https://github.com",
  "logo": {
    "type": "kitty-direct",
    "source": "/Users/imaanjaffer/Downloads/indian1.png",
    "height": 27,
    "width": 38,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "    ",
    "color": "yellow",
    "key": {
      "width": 16
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": " "
      },
      "width": 36  
    }
  },  
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": "{#1}🎀 Imaan Farzana Rafiq 🎀{#}",
      "outputColor": "yellow"
    },
    {
      "type": "custom",
      "format": ""
    },
    { 
      "type": "title",
      "key": "{#1}User{#}",
      "format": "{#1}{user-name}@{host-name}{#}"
    },
    {      
      "type": "uptime",
      "key": "{#1}Uptime{#}",
      "format": "{#1}{} days, {} hours, {} mins{#}"
    },
    {   
      "type": "os",
      "key": "{#1}OS{#}",
      "format": "{#1}{2} {8} {10}{#}"
    },
    { 
      "type": "kernel",
      "key": "{#1}Kernel{#}",
      "format": "{#1}{2}{#}"
    },
    {
      "type": "host",
      "key": "{#1}Device{#}",
      "format": "{#1}{2}{#}"
    },
    {
      "type": "cpu",
      "key": "{#1}CPU{#}",
      "format": "{#1}{1} ({4}) @ {7} GHz{#}"
    },
    {
      "type": "gpu",   
      "key": "{#1}GPU{#}",
      "format": "{#1}{1} ({3}) @ {7} GHz [{9}]{#}"
    },  
    {
      "type": "memory",
      "key": "{#1}RAM{#}",
      "format": "{#1}{1} / {2} ({3}){#}"
    },
    { 
      "type": "disk",
      "key": "{#1}Disk{#}", 
      "format": "{#1}{1} / {2} ({3}) - {4} [{9}]{#}"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "memory",
      "key": "{#1}RAM Usage{#}",
      "outputType": "bar",
      "format": " ",	
      "percent": { 
        "type": 2 
      }
    }, 
    {
      "type": "memory",
      "key": "{#1}{#}",
      "format": "{#1}{1} / {2} ({3}){#}"
    },
    { 
      "type": "disk",
      "key": "{#1}Disk Usage{#}",
      "outputType": "bar",
      "format":" ",
      "percent": {   
        "type": 2
      }
    }, 
    { 
      "type": "disk",
      "key": "{#1}{#}",
      "format": "{#1}{1} / {2} ({3}){#}"
    },
    {
      "type":"custom",
      "format":""
    },			
    {
      "type": "colors",
      "paddingLeft": 5,
      "symbol": "██"
    },
    { 
      "type": "custom",
      "format": ""
    },
    { 
      "type": "custom",
      "format": "                   {#1}{#33}حال كل على لله الحمد{#}{#}"
    }
  ]
}

